#!/bin/bash
set -euo pipefail
exec > >(tee -a /var/log/clinicflow-bootstrap.log) 2>&1
echo "bootstrap started: $(date -u)"
# Safety net: power off after 4 hours so a forgotten node cannot keep billing
shutdown -h +240

export HOME=/root
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

# 1. k3s, pinned to one release
curl -sfL https://get.k3s.io | INSTALL_K3S_VERSION="${k3s_version}" sh -s -
until kubectl get nodes 2>/dev/null | grep -q " Ready"; do sleep 5; done

# 2. Namespaces
kubectl create namespace clinicflow-dev --dry-run=client -o yaml | kubectl apply -f -
kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -

# 3. ECR pull secret, refreshed every 6 hours (ECR tokens last 12)
cat > /usr/local/bin/refresh-ecr-secret.sh <<'SCRIPT'
#!/bin/bash
set -euo pipefail
export HOME=/root
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
TOKEN=$(aws ecr get-login-password --region ${region})
kubectl -n clinicflow-dev create secret docker-registry ecr-pull \
  --docker-server=${ecr_registry} \
  --docker-username=AWS \
  --docker-password="$TOKEN" \
  --dry-run=client -o yaml | kubectl apply -f -
kubectl -n clinicflow-dev patch serviceaccount default \
  -p '{"imagePullSecrets":[{"name":"ecr-pull"}]}'
SCRIPT
chmod 700 /usr/local/bin/refresh-ecr-secret.sh

cat > /etc/systemd/system/refresh-ecr-secret.service <<'UNIT'
[Unit]
Description=Refresh the ECR image pull secret
After=k3s.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/refresh-ecr-secret.sh
UNIT

cat > /etc/systemd/system/refresh-ecr-secret.timer <<'UNIT'
[Unit]
Description=Refresh the ECR image pull secret every 6 hours

[Timer]
OnBootSec=2min
OnUnitActiveSec=6h

[Install]
WantedBy=timers.target
UNIT

systemctl daemon-reload
/usr/local/bin/refresh-ecr-secret.sh
systemctl enable --now refresh-ecr-secret.timer

# 4. Database on RDS: migrate as the master user, then create the app credentials
SECRET_JSON=$(aws secretsmanager get-secret-value --region ${region} --secret-id ${db_master_secret_arn} --query SecretString --output text)
DB_ADMIN_USER=$(printf '%s' "$SECRET_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["username"])')
DB_ADMIN_PASS=$(printf '%s' "$SECRET_JSON" | python3 -c 'import json,sys; print(json.load(sys.stdin)["password"])')
unset SECRET_JSON

# Wait until the new RDS hostname resolves (it can lag the database becoming available)
for i in $(seq 1 60); do
  getent hosts ${db_host} > /dev/null && break
  echo "waiting for DNS: ${db_host} ($i)"
  sleep 10
done
getent hosts ${db_host} > /dev/null || { echo "RDS hostname never resolved"; exit 1; }
APP_PASS=$(openssl rand -hex 16)
DISPATCH_PASS=$(openssl rand -hex 16)
ADMIN_TOKEN=$(openssl rand -hex 16)

mkdir -p /tmp/migrations
for f in ${migration_files}; do
  curl -sfL "${app_raw_url}/db/migrations/$f" -o "/tmp/migrations/$f"
done
kubectl -n clinicflow-dev create configmap db-migration --from-file=/tmp/migrations --dry-run=client -o yaml | kubectl apply -f -
kubectl -n clinicflow-dev create secret generic db-admin \
  --from-literal=PGHOST=${db_host} \
  --from-literal=PGUSER="$DB_ADMIN_USER" \
  --from-literal=PGPASSWORD="$DB_ADMIN_PASS" \
  --from-literal=PGDATABASE=clinicflow \
  --from-literal=PGSSLMODE=require \
  --from-literal=APP_PASS="$APP_PASS" \
  --from-literal=DISPATCH_PASS="$DISPATCH_PASS" \
  --dry-run=client -o yaml | kubectl apply -f -
unset DB_ADMIN_PASS

kubectl -n clinicflow-dev delete job db-migrate --ignore-not-found
kubectl apply -f - <<'JOB'
apiVersion: batch/v1
kind: Job
metadata:
  name: db-migrate
  namespace: clinicflow-dev
spec:
  backoffLimit: 3
  template:
    spec:
      restartPolicy: Never
      containers:
        - name: migrate
          image: postgres:17-alpine
          envFrom:
            - secretRef:
                name: db-admin
          command: ["sh", "-c"]
          args:
            - |
              for i in $(seq 1 60); do pg_isready -q && break; echo "waiting for database ($i)"; sleep 5; done
              pg_isready -q || { echo "database never became ready"; exit 1; }
              psql -v ON_ERROR_STOP=1 -q -c "CREATE TABLE IF NOT EXISTS schema_migrations (name text PRIMARY KEY, applied_at timestamptz NOT NULL DEFAULT now())"
              for f in $(ls /sql | sort); do
                DONE=$(psql -tAc "SELECT 1 FROM schema_migrations WHERE name = '$f'") || exit 1
                if [ "$DONE" = "1" ]; then
                  echo "migration $f already applied, skipping"
                else
                  echo "applying migration $f"
                  psql -v ON_ERROR_STOP=1 -q -1 -f "/sql/$f" -c "INSERT INTO schema_migrations (name) VALUES ('$f')"
                fi
              done
              psql -v ON_ERROR_STOP=1 -c "ALTER ROLE clinicflow_app PASSWORD '$APP_PASS'"
              psql -v ON_ERROR_STOP=1 -c "ALTER ROLE clinicflow_dispatcher PASSWORD '$DISPATCH_PASS'"
          volumeMounts:
            - name: sql
              mountPath: /sql
      volumes:
        - name: sql
          configMap:
            name: db-migration
JOB
kubectl -n clinicflow-dev wait --for=condition=complete job/db-migrate --timeout=600s
kubectl -n clinicflow-dev delete secret db-admin

kubectl -n clinicflow-dev create secret generic api-config \
  --from-literal=DATABASE_URL="postgresql://clinicflow_app:$APP_PASS@${db_host}:5432/clinicflow?sslmode=require" \
  --from-literal=ADMIN_TOKEN="$ADMIN_TOKEN" \
  --dry-run=client -o yaml | kubectl apply -f -

# The dispatcher runs on the host and reads its database URL from a root-only file
install -d -m 0700 /etc/clinicflow
printf 'DATABASE_URL=postgresql://clinicflow_dispatcher:%s@${db_host}:5432/clinicflow?sslmode=require\n' "$DISPATCH_PASS" > /etc/clinicflow/dispatcher.env
chmod 600 /etc/clinicflow/dispatcher.env
# The admin token is needed once, to create the first clinic. Read it with Session Manager.
printf '%s' "$ADMIN_TOKEN" > /root/admin-token
chmod 600 /root/admin-token
unset APP_PASS DISPATCH_PASS ADMIN_TOKEN

# 5. Argo CD, pinned
kubectl apply -n argocd --server-side --force-conflicts \
  -f "https://raw.githubusercontent.com/argoproj/argo-cd/${argocd_version}/manifests/install.yaml"
kubectl wait --for condition=established crd/applications.argoproj.io --timeout=180s
kubectl -n argocd rollout status deploy/argocd-server --timeout=600s

# Save memory on a small node: these three are not needed here
kubectl -n argocd scale deploy argocd-dex-server argocd-notifications-controller argocd-applicationset-controller --replicas=0

# 6. Hand over to GitOps
kubectl apply -f "${gitops_raw_url}/argocd/aws/clinicflow-api-aws.yaml"
# 7. Reminder worker as a hardened systemd service. It runs on the host, so it can use
# the node role through the normal metadata path while pods still cannot reach that role.
dnf install -y python3.12 || echo "python3.12 not available, falling back to the default python3"
PYBIN=$(command -v python3.12 || command -v python3)
echo "worker python: $($PYBIN --version)"
install -d -m 0755 /opt/clinicflow-worker
curl -sfL "${app_raw_url}/worker/worker.py" -o /opt/clinicflow-worker/worker.py
curl -sfL "${app_raw_url}/worker/requirements.txt" -o /opt/clinicflow-worker/requirements.txt
$PYBIN -m venv /opt/clinicflow-worker/venv
/opt/clinicflow-worker/venv/bin/pip install --no-cache-dir -r /opt/clinicflow-worker/requirements.txt \
  || { echo "pinned install failed, installing boto3 unpinned"; /opt/clinicflow-worker/venv/bin/pip install --no-cache-dir boto3; }

cat > /etc/systemd/system/clinicflow-worker.service <<'UNIT'
[Unit]
Description=ClinicFlow reminder worker
After=network-online.target
Wants=network-online.target

[Service]
Environment=AWS_REGION=${region}
Environment=QUEUE_URL=${queue_url}
Environment=SENDER_EMAIL=${sender_email}
Environment=AUDIT_TABLE=${audit_table}
ExecStart=/opt/clinicflow-worker/venv/bin/python /opt/clinicflow-worker/worker.py
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
UNIT

# Reminder dispatcher: turns queued reminders into EventBridge schedules
install -d -m 0755 /opt/clinicflow-dispatcher
curl -sfL "${app_raw_url}/dispatcher/dispatcher.py" -o /opt/clinicflow-dispatcher/dispatcher.py
curl -sfL "${app_raw_url}/dispatcher/requirements.txt" -o /opt/clinicflow-dispatcher/requirements.txt
$PYBIN -m venv /opt/clinicflow-dispatcher/venv
/opt/clinicflow-dispatcher/venv/bin/pip install --no-cache-dir -r /opt/clinicflow-dispatcher/requirements.txt

cat > /etc/systemd/system/clinicflow-dispatcher.service <<'UNIT'
[Unit]
Description=ClinicFlow reminder dispatcher
After=network-online.target
Wants=network-online.target

[Service]
Environment=AWS_REGION=${region}
Environment=SCHEDULE_GROUP=${schedule_group}
Environment=QUEUE_ARN=${queue_arn}
Environment=SCHEDULER_ROLE_ARN=${scheduler_role_arn}
EnvironmentFile=/etc/clinicflow/dispatcher.env
ExecStart=/opt/clinicflow-dispatcher/venv/bin/python /opt/clinicflow-dispatcher/dispatcher.py
Restart=always
RestartSec=5
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
UNIT

# Front desk page for the demo: a loopback-only port-forward. Nothing is exposed to the
# internet. Reach it from a laptop with a Session Manager port-forwarding session.
cat > /etc/systemd/system/clinicflow-ui-forward.service <<'UNIT'
[Unit]
Description=Port-forward the ClinicFlow API to the node loopback
After=k3s.service

[Service]
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
ExecStart=/usr/local/bin/kubectl -n clinicflow-dev port-forward --address 127.0.0.1 svc/clinicflow-api 8000:80
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable --now clinicflow-worker.service
systemctl enable --now clinicflow-dispatcher.service
systemctl enable --now clinicflow-ui-forward.service
sleep 5
systemctl is-active clinicflow-worker.service clinicflow-dispatcher.service

echo "bootstrap finished: $(date -u)"
